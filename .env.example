# Senha do painel /admin
ADMIN_PASSWORD=
# Segredo usado para assinar o cookie do painel (qualquer texto longo e aleatório)
ADMIN_SECRET=

# Banco de dados. Sem esta variável, o app usa um Postgres embutido em .data/ (só para rodar localmente).
# Em produção: a URL de conexão do Postgres (Neon pela Vercel, Supabase, etc.)
DATABASE_URL=

# Arquivos enviados pelos clientes. Sem esta variável, ficam em .data/uploads (só local).
# Em produção: criado automaticamente ao conectar um Blob Store no projeto da Vercel.
BLOB_READ_WRITE_TOKEN=
